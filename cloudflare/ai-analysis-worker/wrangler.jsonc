{
  "name": "spendsmart-ai-analysis",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "observability": { "enabled": true },
  "triggers": {
    // Nightly cleanup of expired sessions, spent throttle windows, and usage
    // rows past retention. See the `scheduled` handler in src/index.ts.
    "crons": ["17 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spendsmart-auth",
      "database_id": "d1613539-69cd-4bb9-8554-601ed38f3293",
      "migrations_dir": "migrations"
    }
  ]
}
